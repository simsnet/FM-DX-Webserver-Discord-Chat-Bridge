DOTENV_CONFIG_QUIET=true

# Discord Bot Token
# For instructions check the README.
DISCORD_TOKEN=

# Discord channel for posting messages
# Enable developer mode in Discord settings then right-click the channel and click "Copy Channel ID".
DISCORD_CHANNEL_ID=1234567890123456789

# Websocket URL for chat
# Use "ws://" for HTTP or "wss://" for HTTPS, then add your server url and port, then "/chat".
# Examples: ws://localhost:8080/chat, wss://tef.example.com/chat
WS_URL=ws://localhost:8080/chat

# Admin identifier badge for WebSocket → Discord messages
# If you want to have a special badge for admins, set it below (default is 👑️ / :crown:).
# For custom emojis you must upload the emoji to your bot in the Discord application settings (where you made your bot) and copy its markdown below.
# To horizontally stack emojis like 2x1, 3x1, or more, divide it into equal square parts and paste the markdowns here without spaces.
# The space between the emoji and nickname is already added in the server code.
DISCORD_ADMIN_BADGE=:crown:
